#!/bin/sh
# DUDES Framework — commit-msg hook
# Enforces: role tag (§13), work-item trailer while an item is bound (F77), branch-role matrix (§12)
# Install: make hooks (core.hooksPath)

# Match bytes, not characters: under git the hook runs with LC_CTYPE=C.UTF-8, where MSYS sed
# misses characters outside the basic plane — such as 🔹 — and every commit would be refused.
LC_ALL=C
export LC_ALL

MSG=$(cat "$1")
BRANCH=$(git branch --show-current 2>/dev/null)

# ── 1. Role tag required ────────────────────────────────────────────
ROLE=$(printf '%s\n' "$MSG" | sed -n 's/.*\(\[🔹[^]]*\]\).*/\1/p' | head -1)
if [ -z "$ROLE" ]; then
  echo ""
  echo "❌ DUDES §13: Missing role tag in commit message."
  echo "   Required format: <type>(<scope>): <desc> [🔹Role]"
  echo "   Example: fix(bookshelf): remove unused import [🔹QA Engineer]"
  echo ""
  exit 1
fi

# ── 1b. Work-item trailer (F77) ─────────────────────────────────────
# While a work item is bound (`# item: <ID>` in .dudes/writable), every commit names it.
SCOPE="$(git rev-parse --show-toplevel)/.dudes/writable"
ITEM=""
[ -f "$SCOPE" ] && ITEM=$(sed -n 's/^# item: *//p' "$SCOPE" | head -1)
if [ -n "$ITEM" ] && ! printf '%s\n' "$MSG" | grep -qxF "Item: $ITEM"; then
  echo ""
  echo "❌ DUDES F77: work item $ITEM is bound, but the commit does not name it."
  echo "   Add the trailer line:  Item: $ITEM"
  echo ""
  exit 1
fi

# ── 1c. Role paths (§14) ────────────────────────────────────────────
# The product's AGENTS.md may carry a `Role paths` row: `Role: globs; Role, Role: globs; …`. The first
# entry whose glob matches a staged path owns it; a role tag that names one of the row's roles may
# commit only the paths its role owns. A tag that names none (DevOps, human, engine), a merge in
# progress and a repo without the row keep today's behaviour. `*` also matches `/`.
owns() { # $1 = a comma list of roles, $2 = the tag: succeeds when the tag names one of them
  printf '%s\n' "$1" | tr ',' '\n' | {
    while IFS= read -r o; do
      o=$(printf '%s' "$o" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      if [ -n "$o" ]; then case "$2" in *"$o"*) exit 0 ;; esac; fi
    done
    exit 1
  }
}
PATHROW=$(sed -n 's/^|[[:space:]]*Role paths[[:space:]]*|\(.*\)|[[:space:]]*$/\1/p' "$(git rev-parse --show-toplevel)/AGENTS.md" 2>/dev/null | head -1 | tr -d '`')
if [ -n "$PATHROW" ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  set -f
  ENTRIES=$(printf '%s\n' "$PATHROW" | tr ';' '\n' | grep ':')
  NAMED=""
  while IFS= read -r e; do
    owns "${e%%:*}" "$ROLE" && NAMED=1
  done <<EOF2
$ENTRIES
EOF2
  if [ -n "$NAMED" ]; then
    BAD=""
    STAGED=$(git -c core.quotepath=off diff --cached --no-renames --name-only)
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      OWN=""
      while IFS= read -r e; do
        for pat in ${e#*:}; do
          case "$p" in $pat) OWN=${e%%:*}; break ;; esac
        done
        [ -n "$OWN" ] && break
      done <<EOF2
$ENTRIES
EOF2
      if [ -n "$OWN" ] && ! owns "$OWN" "$ROLE"; then
        BAD="$BAD   $p  (owner: $(printf '%s' "$OWN" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'))
"
      fi
    done <<EOF2
$STAGED
EOF2
    if [ -n "$BAD" ]; then
      echo ""
      echo "❌ DUDES §14: role $ROLE does not own these staged paths (Role paths row of AGENTS.md):"
      printf '%s' "$BAD"
      echo "   Fix: unstage them and hand off to the role that owns them, or commit them under that role."
      echo ""
      exit 1
    fi
  fi
  set +f
fi

# ── 2. Branch-role matrix (§12) ─────────────────────────────────────
case "$BRANCH" in
  release/*)
    # Spec repo (a *_PRD.md at its root): the branch is the frozen spec — only QA, only the QR.
    # One-repo product (its AGENTS.md has the starter's Repo type row): the release branch holds
    # the QR, nothing else — the same guard, though its PRD sits under spec/, not at the root.
    # Dev repo: release/<product>-vX.Y is the patch line — every role may commit there.
    ONE=""
    if ! git ls-files ':(glob)*_PRD.md' | grep -q .; then
      TOP=$(git rev-parse --show-toplevel)
      grep -qiE '^\|[[:space:]]*Repo type[[:space:]]*\|[[:space:]]*Spec and dev in one repo' "$TOP/AGENTS.md" 2>/dev/null || exit 0
      ONE=1
    fi
    case "$ROLE" in
      *"QA Engineer"*) ;; # allowed
      *)
        echo ""
        echo "❌ DUDES §12: Role $ROLE cannot commit on the frozen spec branch $BRANCH."
        echo "   Only [🔹QA Engineer] may commit here, and only the QR."
        echo "   Fix: commit spec changes on development — they reach the next line."
        echo ""
        exit 1
        ;;
    esac
    # One repo: QA merges development into the release branch before a re-run (§6). The merge brings
    # every file of the line, so the staged-files check does not apply to it.
    [ -n "$ONE" ] && git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
    OTHER=$(git diff --cached --name-only | grep -v '_QR\.md$')
    if [ -n "$OTHER" ]; then
      echo ""
      echo "❌ DUDES §12: $BRANCH is the frozen spec — only *_QR.md may change. Staged besides the QR:"
      printf '%s\n' "$OTHER" | sed 's/^/   /'
      echo "   Fix: commit them on development — they reach the next line."
      echo ""
      exit 1
    fi
    ;;
  development|main)
    # QR commits must go on release branches, not development
    if echo "$MSG" | grep -qiE '(QR|quality.report)' && echo "$ROLE" | grep -q "QA Engineer"; then
      echo ""
      echo "❌ DUDES §12: QR artifacts belong on release/* branch, not $BRANCH."
      echo "   Fix: git checkout release/<product>-v<X.Y>, then commit."
      echo ""
      exit 1
    fi
    ;;
esac

exit 0
