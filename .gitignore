# Instance repos nested in the workspace are excluded locally (.git/info/exclude), never named here.

# IDEs
.vscode/
.cline/
nul

# Local noise
*.log
.env
*.txt
*.py
*.js
# A ladder level's committed inputs are text files (bench/L4: the notes file its golden file is rendered from)
!bench/*/testdata/**/*.txt

# Go engine
/bin/
dudes.json
*.exe
.dudes/

# Agent ephemeral scratchpad (never commit)
SESSION_STATE.md

/.cache/
/.claude/worktrees/
